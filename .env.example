# ==============================================================================
# IGRAPH MEDIA — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development.
# In Vercel, configure these under: Project Settings > Environment Variables.
# ==============================================================================

# 1. SUPABASE DATABASE & AUTHENTICATION
# Obtain these from your Supabase Project Dashboard: Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for client browsers)
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Keep private! Used securely by Vercel serverless functions)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. GOOGLE GEMINI AI
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# Used securely by /api/chat to power the AI Advisory Concierge
GEMINI_API_KEY=your-google-gemini-api-key

# 3. OPERATIONAL NOTIFICATIONS (Optional)
# Inbound notifications for new leads and consultation bookings
ADMIN_NOTIFICATION_EMAIL=advisory@igraphmedia.com
SLACK_WEBHOOK_URL=
