# ============================================================
# IGRAPH MEDIA — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local testing.
# Never commit real secrets to GitHub or public repositories.
# ============================================================

# Security: Allowed Origins for Chat and Lead Endpoints (comma-separated)
ALLOWED_ORIGINS=https://igraphmedia.com.ng,https://www.igraphmedia.com.ng,https://igraph-media.vercel.app,https://igraphmedia.com,https://www.igraphmedia.com,http://localhost:8080,http://localhost:3000

# Lead Notifications (Optional - Resend integration)
# Get an API key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here
LEAD_TO_EMAIL=hello@igraphmedia.com.ng

# Google Gemini API Configuration (Server-Side Only for Concierge)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Supabase Production Database Credentials (Optional)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
