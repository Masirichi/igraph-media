# ============================================================
# IGRAPH MEDIA — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local testing.
# Never commit real secrets to GitHub or public repositories.
# ============================================================

# Google Gemini API Configuration (Server-Side Only)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Security: Allowed Origins for Chat and Lead Endpoints (comma-separated)
ALLOWED_ORIGINS=https://igraph-media.vercel.app,https://igraphmedia.com,https://www.igraphmedia.com,http://localhost:8080,http://localhost:3000

# Supabase Production Database Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Lead Notifications (Optional - Resend integration)
# Get a key at https://resend.com
RESEND_API_KEY=
LEAD_TO_EMAIL=advisory@igraphmedia.com
ADMIN_NOTIFICATION_EMAIL=advisory@igraphmedia.com
